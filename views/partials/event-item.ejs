<li class="event-item<%= e.cancelled ? ' is-cancelled' : '' %>">
  <div class="event-date" aria-hidden="true"><strong><%= e.event_date.slice(8,10) %></strong><span><%= d.MONTHS[Number(e.event_date.slice(5,7))-1].slice(0,3) %></span></div>
  <div>
    <a href="<%= typeof eventBase !== 'undefined' ? eventBase : '/intranet/calendario/' %><%= e.id %><%= typeof eventSuffix !== 'undefined' ? eventSuffix : '' %>" class="event-title"><%= e.title %></a>
    <% if (e.cancelled) { %><span class="badge badge-cancel">Cancelado</span><% } else if (e.change_count) { %><span class="badge badge-change">Alterado</span><% } %>
    <p class="muted small"><%= d.fmtLongDate(e.event_date) %> · <%= d.fmtTimeRange(e.start_time, e.end_time) %><% if (e.location) { %> · <%= e.location %><% } %></p>
  </div>
</li>
