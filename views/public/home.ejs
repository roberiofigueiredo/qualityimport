<%- include('../partials/head') %>
<body class="public">
<a class="skip" href="#conteudo">Pular para o conteúdo</a>
<header class="site-header">
  <div class="wrap site-header-inner">
    <a class="brand" href="/"><%- include('../partials/logo') %></a>
    <nav class="site-nav" aria-label="Seções">
      <a href="#sobre">A empresa</a>
      <a href="#linhas">Linhas de peças</a>
      <a href="#lojas">Lojas</a>
    </nav>
    <a class="btn btn-outline btn-sm colab-btn" href="/entrar">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4-6 8-6s7 2 8 6"/></svg>
      Área do Colaborador
    </a>
  </div>
</header>

<main id="conteudo">
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-text">
        <p class="eyebrow">Autopeças para todas as necessidades</p>
        <h1><%= settings.slogan || settings.company_name %></h1>
        <p class="lead">Encontre a loja mais próxima ou peça seu orçamento agora mesmo pelo WhatsApp. Nossa equipe ajuda você a encontrar a peça certa.</p>
        <div class="hero-ctas">
          <a class="btn btn-whatsapp btn-lg" href="/orcamento" data-track="orcamento-geral">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z"/></svg>
            Solicitar orçamento pelo WhatsApp
          </a>
          <a class="btn btn-light btn-lg" href="#lojas">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>
            Encontrar uma loja
          </a>
        </div>
        <% if (!settings.whatsapp_number) { %><p class="hero-note">WhatsApp comercial: <%- include('../partials/pendente') %></p><% } %>
      </div>
      <div class="hero-art">
        <% if (settings.hero_file_id) { %>
          <img src="/arquivos/<%= settings.hero_file_id %>" alt="Autopeças e atendimento nas lojas <%= settings.company_name %>">
        <% } else { %>
          <img src="/static/img/hero-pecas.svg" alt="Ilustração de autopeças: disco de freio, amortecedor, filtro e vela de ignição" width="560" height="420">
        <% } %>
      </div>
    </div>
  </section>

  <section id="sobre" class="section">
    <div class="wrap about">
      <div class="about-art"><img src="/static/img/atendimento-loja.svg" alt="Ilustração de atendimento no balcão de uma loja de autopeças" width="520" height="380" loading="lazy"></div>
      <div>
        <p class="eyebrow">Quem somos</p>
        <h2><%= settings.company_name %></h2>
        <p class="lead-sm"><%= settings.about_text %></p>
        <ul class="ticks">
          <li>Atendimento especializado no balcão e pelo WhatsApp</li>
          <li>Peças para manutenção preventiva e corretiva</li>
          <li>Lojas próximas de você</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="linhas" class="section section-gray">
    <div class="wrap">
      <p class="eyebrow center">O que você encontra</p>
      <h2 class="center">Principais linhas de autopeças</h2>
      <div class="lines-grid">
        <% lines.forEach(function(l){ %>
          <article class="line-card">
            <%- include('../partials/line-icon', { icon: l.icon }) %>
            <h3><%= l.name %></h3>
            <% if (l.description) { %><p><%= l.description %></p><% } %>
          </article>
        <% }) %>
      </div>
    </div>
  </section>

  <section id="lojas" class="section">
    <div class="wrap">
      <p class="eyebrow center">Nossas filiais</p>
      <h2 class="center">Encontre uma loja</h2>
      <form class="store-search" method="get" action="/#lojas" role="search" data-store-search>
        <label class="sr-only" for="busca-loja">Buscar por bairro, cidade ou nome da loja</label>
        <input id="busca-loja" type="search" name="busca" value="<%= busca %>" placeholder="Busque por bairro, cidade ou nome da loja">
        <% if (cities.length > 1) { %>
        <label class="sr-only" for="cidade">Cidade</label>
        <select id="cidade" name="cidade">
          <option value="">Todas as cidades</option>
          <% cities.forEach(function(c){ %><option <%= c === cidade ? 'selected' : '' %>><%= c %></option><% }) %>
        </select>
        <% } %>
        <button class="btn btn-primary" type="submit">Buscar</button>
      </form>
      <p class="muted center small" data-store-count><%= branches.length %> de <%= totalBranches %> loja(s)</p>
      <div class="stores">
        <% branches.forEach(function(b){
             const mapUrl = b.map_url || (b.address ? 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(b.address + (b.city ? ', ' + b.city : '')) : '');
        %>
        <article class="store-card" data-store="<%= [b.name, b.city, b.address].join(' ').toLowerCase() %>" data-city="<%= b.city || '' %>" id="loja-<%= b.id %>">
          <h3><%= b.name %><% if (b.city) { %> <span class="muted">· <%= b.city %></span><% } %></h3>
          <dl>
            <div><dt>Endereço</dt><dd><%= b.address || '' %><% if (!b.address) { %><%- include('../partials/pendente') %><% } %></dd></div>
            <div><dt>Telefone</dt><dd><% if (b.phone) { %><a href="<%= h.telLink(b.phone) %>"><%= b.phone %></a><% } else { %><%- include('../partials/pendente') %><% } %></dd></div>
            <div><dt>Horário</dt><dd class="pre"><%= b.hours || '' %><% if (!b.hours) { %><%- include('../partials/pendente') %><% } %></dd></div>
          </dl>
          <div class="store-actions">
            <a class="btn btn-whatsapp btn-sm" href="/orcamento?filial=<%= b.id %>">Orçamento nesta loja</a>
            <% if (mapUrl) { %><a class="btn btn-outline btn-sm" href="<%= mapUrl %>" target="_blank" rel="noopener">Ver no mapa</a>
            <% } else { %><span class="btn btn-outline btn-sm disabled" aria-disabled="true">Mapa: pendente de cadastro</span><% } %>
          </div>
        </article>
        <% }) %>
        <% if (!branches.length) { %><p class="empty">Nenhuma loja encontrada para essa busca. <a href="/#lojas">Ver todas</a></p><% } %>
      </div>
    </div>
  </section>

  <section class="cta-strip">
    <div class="wrap cta-inner">
      <div><h2>Precisa de uma peça?</h2><p>Envie o modelo do veículo e a peça que procura. Respondemos com o orçamento.</p></div>
      <a class="btn btn-whatsapp btn-lg" href="/orcamento">Solicitar orçamento pelo WhatsApp</a>
    </div>
  </section>
</main>

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <a class="brand brand-footer" href="/"><%- include('../partials/logo') %></a>
      <p class="small">CNPJ: <%= settings.cnpj || '' %><% if (!settings.cnpj) { %><%- include('../partials/pendente') %><% } %></p>
    </div>
    <div>
      <h3>Contato</h3>
      <p>Telefone: <% if (settings.contact_phone) { %><a href="<%= h.telLink(settings.contact_phone) %>"><%= settings.contact_phone %></a><% } else { %><%- include('../partials/pendente') %><% } %></p>
      <p>E-mail: <% if (settings.contact_email) { %><a href="mailto:<%= settings.contact_email %>"><%= settings.contact_email %></a><% } else { %><%- include('../partials/pendente') %><% } %></p>
      <p>WhatsApp: <% if (settings.whatsapp_number) { %><a href="/orcamento"><%= settings.whatsapp_number %></a><% } else { %><%- include('../partials/pendente') %><% } %></p>
    </div>
    <div>
      <h3>Redes sociais</h3>
      <% if (settings.instagram_url) { %><p><a href="<%= settings.instagram_url %>" target="_blank" rel="noopener">Instagram</a></p><% } %>
      <% if (settings.facebook_url) { %><p><a href="<%= settings.facebook_url %>" target="_blank" rel="noopener">Facebook</a></p><% } %>
      <% if (!settings.instagram_url && !settings.facebook_url) { %><p><%- include('../partials/pendente') %></p><% } %>
      <p><a href="/entrar">Área do Colaborador</a></p>
    </div>
  </div>
  <div class="wrap footer-bottom small">© <%= new Date().getFullYear() %> <%= settings.company_name %>. Todos os direitos reservados.</div>
</footer>
</body>
</html>
